{
  "name": "threejs-modular-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/main.js",
    "play": "npm run build && node server/main.js --production",
    "build": "vite build && node scripts/verify-build.mjs",
    "check": "gts check",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "test:physics": "vitest run test/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "gts": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "tmp": "^0.2.3",
    "minimatch": "^11.0.1",
    "cross-spawn": "^7.0.6",
    "rimraf": "^5.0.0",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.18.0"
  }
}

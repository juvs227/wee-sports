{
  "name": "@wee/native-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export --platform all",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-camera": "58.0.14",
    "expo-dev-client": "58.0.18",
    "expo-haptics": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-sensors": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "socket.io-client": "4.8.4"
  }
}
